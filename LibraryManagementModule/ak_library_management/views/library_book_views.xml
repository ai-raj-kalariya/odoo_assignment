<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_book_list_view" model="ir.ui.view">
        <field name="name">library.book.list.view</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Lms">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="library_book_form_view" model="ir.ui.view">
        <field name="name">library.book.form.view</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Lms">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group>
                            <field name="author"/>
                            <field name="category_id"/>
                            <field name="isbn"/>
                        </group>
                        <group>
                            <field name="publication_date"/>
                            <field name="description"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Activity-->
    <record id="library_book_actions" model="ir.actions.act_window">
        <field name="name">Library Book</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>