<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Header Footer adjustment-->
    <template id="product_catalog_style_1_template">
        <div class="header" style="text-align:center;">
            <p>Generated Product Catalog</p>
        </div>
        <div class="article">
            <t t-set="counter" t-value="0"/>
            <t t-foreach="o.product_ids" t-as="product">
                <div class="container">
                    <div class="row"
                         style="display: flex; margin-bottom: 10px; border-bottom: 2px solid #b05fa5; padding-bottom: 10px;">
                        <div class="col-3">
                            <img t-if="product.image_1920" t-att-src="image_data_uri(product.image_1920)"
                                 class="card-img-left"
                                 loading='lazy' alt="product image"
                                 style="width: 150px; border-radius: 5px; margin-right: 20px; object-fit: cover;"/>
                        </div>
                        <div class="col-9">
                            <div t-field="product.name" style="font-size:20pt; font-weight:bold;"/>
                            <p style="background:#ababab; width:200px; text-align:center; margin:2px;"
                               t-field="product.default_code"/>
                            <p style="background:#ababab; width:200px;">
                                <span>
                                    <b>Price:</b>
                                </span>
                                <span t-field="product.list_price"
                                      t-options='{"widget": "monetary","display_currency": product.currency_id}'/>
                            </p>
                            <div>
                                <t t-esc="product.description_sale"/>
                            </div>
                        </div>
                    </div>
                    <t t-set="counter" t-value="counter + 1"/>
                    <t t-if="counter == o.page_break_after or counter == 5">
                        <div style="page-break-after: always;"/>
                        <t t-set="counter" t-value="0"/>
                    </t>
                </div>
            </t>
        </div>
    </template>

    <template id="product_catalog_style_2_template">
        <div class="article">
            <t t-set="counter" t-value="0"/>
            <div>
                <t t-foreach="o.product_ids" t-as="product">
                    <div style="display: inline-block; width:47%; height:475px; border: 2px dashed purple; text-align:center; padding: 5px 10px 5px 10px; margin:10px; ">
                        <p t-field="product.name" style="font-size:20px; font-weight:bold;"/>
                        <img t-if="product.image_1920" t-att-src="image_data_uri(product.image_1920)"
                             style="height:170px; width:100%;"/>
                        <img t-if="not product.image_1920"
                             style="height:170px; width:100%; object-fit:cover;" alt="product image"/>
                        <p style="background-color: yellow; text-align:center; padding: 3px 8px; font-weight: bold; margin-bottom: 5px;"
                           t-field="product.default_code"/>
                        <p style="background:yellow; padding: 20px; text-align:center;">
                            <span t-field="product.list_price"
                                  t-options='{"widget": "monetary","display_currency": product.currency_id}'/>
                        </p>
                        <hr style="color:#b05fa5;"/>
                        <t t-if="not product.description_sale">
                            <p style="text-align:center;">No Description</p>
                        </t>
                        <p t-out="product.description_sale" style="padding-bottom:80px"/>
                    </div>
                    <t t-set="counter" t-value="counter + 1"/>
                    <t t-if="counter == 4">
                        <div style="page-break-after: always;"/>
                        <t t-set="counter" t-value="0"/>
                    </t>
                </t>
            </div>
        </div>
    </template>

    <template id="product_catalog_style_1_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ak_product_cataloge_pdf.product_catalog_style_1_template"/>
            </t>
        </t>
    </template>

    <template id="product_catalog_style_2_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ak_product_cataloge_pdf.product_catalog_style_2_template"/>
            </t>
        </t>
    </template>

    <record id="custom_product_catalog_style_page_format" model="report.paperformat">
        <field name="name">Product Catalog 1 Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>z

    <record id="custom_product_catalog_style_1_report_id" model="ir.actions.report">
        <field name="name">Product Catalog Style 1</field>
        <field name="model">product.catalog.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_product_cataloge_pdf.product_catalog_style_1_report_template</field>
        <field name="report_file">ak_product_cataloge_pdf.product_catalog_style_1_report_template</field>
    </record>

    <record id="custom_product_catalog_style_2_report_id" model="ir.actions.report">
        <field name="name">Product Catalog Style 2</field>
        <field name="model">product.catalog.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_product_cataloge_pdf.product_catalog_style_2_report_template</field>
        <field name="report_file">ak_product_cataloge_pdf.product_catalog_style_2_report_template</field>
        <field name="paperformat_id" ref="ak_product_cataloge_pdf.custom_product_catalog_style_page_format"/>
    </record>
</odoo>
