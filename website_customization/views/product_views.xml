<odoo>
    <template id="custom_cart_product_card" name="Custom Cart Product Card">
        <div class="card mb-2 p-2 d-flex flex-row align-items-center justify-content-between border rounded shadow-sm"
             t-attf-id="custom_cart_product_{{ product.id }}">
            <div class="d-flex align-items-center gap-2">
                <t t-if="product.image_128">
                    <img t-att-src="'data:image/png;base64,%s' % product.image_128.decode('utf-8')"
                         class="img-thumbnail"
                         style="width: 48px; height: 48px;"
                         alt="Product Image"/>
                </t>
                <span class="fw-semibold" t-esc="product.name"/>
            </div>

            <div class="d-flex align-items-center gap-1">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm custom-cart-sub"
                        t-att-data-product-id="product.id">−</button>
                <span class="custom-cart-qty fw-bold" t-esc="qty"/>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm custom-cart-add"
                        t-att-data-product-id="product.id">+</button>
            </div>

            <div class="d-flex align-items-center">
                <span class="me-1">Price:</span>
                <span class="custom-cart-price fw-bold" t-esc="price"/>
            </div>
        </div>
    </template>
</odoo>
