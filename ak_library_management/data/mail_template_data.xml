<?xml version="1.0" ?>
<odoo>
    <data noupdate="1">
        <record id="mail__send_alert_for_return" model="mail.template">
            <field name="name">Return Book</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="subject">{{ object.company_id.name }} Return book (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Sent through schedule action to customer</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        <t t-out="object.partner_id.name or ''">Azure Interior</t>
                        <br/>
                        <br/>
                        You Borrowed book and return date of that book has passed.
                        So return that book for avoid penalty.
                        <br/>
                        <br/>
                        Do not hesitate to contact us if you have any questions.
                        <br/>
                        <br/>
                        Best regards,
                        <t t-if="not is_html_empty(user.signature)">
                            <br/>
                            <br/>
                            <t t-out="user.signature or ''">--<br/>Mitchell Admin
                            </t>
                        </t>
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('borrow_transaction_history'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>