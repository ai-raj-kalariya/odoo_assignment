<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="seq_library_member" model="ir.sequence">
            <field name="name">Library Member</field>
            <field name="code">library.member</field>
            <field name="prefix">MEM-%(year)s-%(month)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
    <data>
        <record id="seq_library_book" model="ir.sequence">
            <field name="name">Library Book</field>
            <field name="code">product.template</field>
            <field name="prefix">BOOK-%(year)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>