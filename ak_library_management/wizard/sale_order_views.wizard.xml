<odoo>
    <record id="sale_order_warning_wizard_view" model="ir.ui.view">
        <field name="name">sale.order.warning.wizard.view</field>
        <field name="model">sale.order.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval Needed">
                <group>
                    <field nolabel="1" name="message" readonly="1"/>
                </group>
                <footer>
                    <button string="Confirm"
                            name="action_mark_approved"
                            type="object"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_order_warning_wizard_action" model="ir.actions.act_window">
        <field name="name">Sale Order Warning</field>
        <field name="res_model">sale.order.warning.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ak_library_management.sale_order_warning_wizard_view"/>
        <field name="target">new</field>
    </record>
</odoo>
