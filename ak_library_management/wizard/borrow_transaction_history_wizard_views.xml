<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Form view-->
    <record id="borrow_transaction_history_wizard_view" model="ir.ui.view">
        <field name="name">borrow.transaction.history.wizard.view</field>
        <field name="model">borrow.transaction.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Borrowed Book">
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="deposit_amount" invisible="is_member"/>
                        </group>
                        <group>
                            <field name="borrow_start_date"/>
                            <field name="borrow_end_date"/>
                            <field name="books_ids" widget="many2many_tags" context="{'add_author':True}"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>