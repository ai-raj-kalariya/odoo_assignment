<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Form view-->
    <record id="borrow_transaction_history_wizard_view" model="ir.ui.view">
        <field name="name">borrow.transaction.history.wizard.view</field>
        <field name="model">borrow.transaction.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Borrowed Book">
                <field name="message"/>
                <footer>
                    <button special="save" string="Continue" class="btn-primary"  />
                    <button name="action_cancel" string="Cancel" type="object" class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
