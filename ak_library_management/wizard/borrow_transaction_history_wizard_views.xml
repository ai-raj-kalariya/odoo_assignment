<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Form view-->
    <record id="borrow_transaction_history_wizard_view" model="ir.ui.view">
        <field name="name">borrow.transaction.history.wizard.view</field>
        <field name="model">borrow.transaction.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Borrowed Book">
                <group>
                    <field nolabel="1" name="message" readonly="1"/>
                </group>
                <footer>
                    <button string="Cancel" name="action_cancel" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
    <!--Action-->
    <record id="borrow_transaction_history_wizard_action" model="ir.actions.act_window">
        <field name="name">Borrowed Book</field>
        <field name="res_model">borrow.transaction.history.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ak_library_management.borrow_transaction_history_wizard_view"/>
        <field name="target">new</field>
    </record>
</odoo>
