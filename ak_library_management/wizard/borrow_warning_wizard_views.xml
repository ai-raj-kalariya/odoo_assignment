<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_borrow_transaction_history_wizard" model="ir.ui.view">
        <field name="name">borrow.transaction.history.wizard</field>
        <field name="model">borrow.transaction.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Borrow Transaction Warning" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="message" nolabel="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Continue" type="object" class="oe_highlight"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_borrow_transaction_history_wizard" model="ir.actions.act_window">
        <field name="name">Borrow Transaction Warning</field>
        <field name="res_model">borrow.transaction.history.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_borrow_transaction_history_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
