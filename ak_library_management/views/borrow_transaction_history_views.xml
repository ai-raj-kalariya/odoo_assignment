<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--List view-->
    <record id="borrow_transaction_history_list_view" model="ir.ui.view">
        <field name="name">borrow.transaction.history.list.view</field>
        <field name="model">borrow.transaction.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="books_ids"/>
                <field name="borrow_start_date"/>
                <field name="borrow_end_date"/>
                <field name="deposit_amount"/>
            </list>
        </field>
    </record>

    <!--Search view-->
    <record id="borrow_transaction_history_search_view" model="ir.ui.view">
        <field name="name">borrow.transaction.history.search.view</field>
        <field name="model">borrow.transaction.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_id"/>
                <group>
                    <filter name="return_date_group_by"
                            context="{'group_by':'borrow_end_date'}"
                            domain="[]" string="Due Date"/>
                </group>
            </search>
        </field>
    </record>

    <!--Form view-->
    <record id="borrow_transaction_history_form_view" model="ir.ui.view">
        <field name="name">borrow.transaction.history.form.view</field>
        <field name="model">borrow.transaction.history</field>
        <field name="arch" type="xml">
            <form string="borrow_transaction_history">
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="deposit_amount" invisible="is_member"/>
                        </group>
                        <group>
                            <field name="borrow_start_date"/>
                            <field name="borrow_end_date"/>
                            <field name="books_ids" widget="many2many_tags" context="{'add_author':True}"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="borrow_transaction_history_action" model="ir.actions.act_window">
        <field name="name">Borrow Transaction History</field>
        <field name="res_model">borrow.transaction.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>