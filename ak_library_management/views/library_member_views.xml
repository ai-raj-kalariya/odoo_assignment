<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--list view-->
    <record id="library_member_list_view" model="ir.ui.view">
        <field name="name">library.member.list.view</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="Library Members">
                <field name="membership_no"/>
                <field name="member_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="membership_date"/>
            </list>
        </field>
    </record>
    <!--form view-->
    <record id="library_member_form_view" model="ir.ui.view">
        <field name="name">library.member.form.view</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Library Member">
                <header>
                    <button name="action_send_mail" string="Send Email" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="membership_no"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="membership_date"/>
                        </group>
                        <group>
                            <field name="html"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Action-->
    <record id="library_member_action" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
