<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--list view-->
    <record id="library_book_tags_list_view" model="ir.ui.view">
        <field name="name">library.book.tags.list.view</field>
        <field name="model">library.book.tags</field>
        <field name="arch" type="xml">
            <list string="Lms">
                <field name="name"/>
            </list>
        </field>
    </record>
    <!--form view-->
    <record id="library_book_tags_form_view" model="ir.ui.view">
        <field name="name">library.book.tags.form.view</field>
        <field name="model">library.book.tags</field>
        <field name="arch" type="xml">
            <form string="Lms">
                <group>
                    <field name="name"/>
                    <field name="library_book_category_id" invisible="1"/>
                </group>
            </form>
        </field>
    </record>

    <!--Action-->
    <record id="library_book_tags_action" model="ir.actions.act_window">
        <field name="name">Book Tags</field>
        <field name="res_model">library.book.tags</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>