<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--List view -->
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='standard_price_uom']/field[@name='standard_price']" position="attributes">
                <attribute name="readonly">sale_ok</attribute>
            </xpath>
        </field>
    </record>
    <!--form view -->
    <record id="product_template_only_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <header>
                <div>
                    <button name="is_available" string="Mark as Available" type="object"
                            invisible="state == 'available'"/>
                </div>
                <!--When we click on this button then state convert into borrowed-->
                <div>
                    <button name="is_borrowed" string="Mark as Borrowed"
                            type="object"/>
                </div>
                <!--When we click on this button then state convert into returned-->
                <div>
                    <button name="is_returned" string="Return Book"
                            type="object"
                            invisible="state == 'available'"/>
                </div>
                <!--When we click on this button open wizard for borrow transaction history model.-->
                <div>
                    <button name="borrow_books" string="Borrow Books"
                            type="object"/>
                </div>
                <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
            </header>
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Book Details" name="book_details">
                    <group>
                        <group>
                            <field name="is_library_book" required="sale_ok"/>
                            <field name="author_id" required="sale_ok"/>
                            <field name="publisher" required="sale_ok"/>
                            <field name="edition" required="sale_ok"/>
                        </group>
                        <group>
                            <field name="published_date" required="sale_ok"/>
                            <field name="pages" required="sale_ok"/>
                            <field name="available" required="sale_ok"/>
                            <field name="user_id" required="sale_ok" groups="ak_library_management.group_library_admin"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!--Change the lable of barcode to ISBN number-->
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="string">ISBN Number</attribute>
            </xpath>
            <!--move field from general information to Book detail-->
            <xpath expr="//field[@name='available']" position="after">
                <xpath expr="//field[@name='barcode']" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
