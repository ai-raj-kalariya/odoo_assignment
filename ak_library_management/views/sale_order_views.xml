<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sale_order_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="invisible">state != 'draft' or check_ok</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="approve_order" string="Approve" type="object"
                        invisible="state not in ['draft', 'sent'] or not id or locked or not check_ok"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="reject_order" string="Reject" type="object"
                        invisible="state not in ['draft', 'sent', 'sale'] or not id or locked or not check_ok"/>
            </xpath>
        </field>
    </record>
</odoo>