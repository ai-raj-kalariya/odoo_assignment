<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--list view-->
    <record id="bulk_upload_book_list_view" model="ir.ui.view">
        <field name="name">bulk.upload.book.list.view</field>
        <field name="model">bulk.upload.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="book_names"/>
                <field name="author_id"/>
            </list>
        </field>
    </record>
    <!--form view-->
    <record id="bulk_upload_book_form_view" model="ir.ui.view">
        <field name="name">bulk.upload.book.form.view</field>
        <field name="model">bulk.upload.book</field>
        <field name="arch" type="xml">
            <form string="bulk_book">
                <header>
                    <div>
                        <button name="create_book" string="Create Products" type="object"/>
                    </div>
                    <div>
                        <button name="revert_changes" string="Revert Changes" type="object"
                        invisible="not product_ids"/>
                    </div>
                </header>
                <sheet>
                <!--Smart Button-->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_created_book"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="not product_ids">
                            <field name="created_book_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <group>
                        <field name="book_names"/>
                        <field name="author_id" required="true"/>
                        <field name="category"/>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Action-->
    <record id="bulk_upload_book_action" model="ir.actions.act_window">
        <field name="name">Bulk Upload Book</field>
        <field name="res_model">bulk.upload.book</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>