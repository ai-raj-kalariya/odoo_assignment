<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--list view-->
    <record id="library_book_category_list_view" model="ir.ui.view">
        <field name="name">library.book.category.list.view</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <list string="Lms">
                <field name="name"/>
                <field name="tag_ids"/>
            </list>
        </field>
    </record>
    <!--form view-->
    <record id="library_book_category_form_view" model="ir.ui.view">
        <field name="name">library.book.category.form.view</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <form string="Lms">
                <group>
                    <field name="name"/>
                    <field name="tag_ids" widget="many2many_tags"/>
                </group>
            </form>
        </field>
    </record>

    <!--Action-->
    <record id="library_book_category_action" model="ir.actions.act_window">
        <field name="name">Book Category</field>
        <field name="res_model">library.book.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>