<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu -->
    <menuitem
            id="ak_library_management_menu"
            name="Library Management"/>

    <menuitem
            id="library_library_menu"
            name="Library"
            parent="ak_library_management_menu"
            sequence="10"
            action="library_library_actions"/>

    <menuitem
            id="library_book_menu"
            name="Book"
            parent="ak_library_management_menu"
            sequence="20"
            action="library_book_actions"/>

    <menuitem
            id="library_member_menu"
            name="Members"
            parent="ak_library_management_menu"
            sequence="30"/>

    <menuitem
            id="library_member_sub_menu"
            name="Members"
            parent="library_member_menu"
            sequence="10"
            action="library_member_action"/>

    <menuitem
            id="configuration_menu"
            name="Configuration"
            parent="ak_library_management_menu"
            sequence="40"/>

    <menuitem
            id="library_book_tags_menu"
            name="Book Tags"
            parent="configuration_menu"
            sequence="20"
            action="library_book_tags_action"/>

    <menuitem
            id="library_book_category_menu"
            name="Book Category"
            parent="configuration_menu"
            sequence="30"
            action="library_book_category_action"/>

    <menuitem
            id="library_product_template_menu"
            name="Products"
            parent="ak_library_management_menu"
            sequence="50"/>

    <menuitem
            id="library_product_template_sub_menu"
            name="Product"
            parent="library_product_template_menu"
            sequence="50"
            action="sale.product_template_action"/>
    <menuitem
            id="bulk_upload_book_menu"
            name="Bulk Book"
            parent="ak_library_management_menu"
            sequence="60"
            action="bulk_upload_book_action"/>

    <!--Inherit menuitems from sale-->
    <menuitem id="sale.menu_products"
            name="Product Items"
            parent="sale.product_menu_catalog"
            action="product.product_normal_action_sell"
            groups="product.group_product_variant"
            sequence="40"/>

    <menuitem id="sale.res_partner_menu"
            action="account.res_partner_action_customer"
            parent="sale.menu_sale_config"
            groups="sales_team.group_sale_salesman"
            sequence="25"/>

    <!--Inherit Window action from sale-->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="name">Draft Quotations</field>
<!--        <field name="res_model">sale.order</field>-->
        <field name="view_mode">list</field>
    </record>
</odoo>
