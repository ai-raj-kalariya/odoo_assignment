<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--List view -->
    <record id="res_users_list_views_inherit" model="ir.ui.view">
        <field name="name">res.users.list.views</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_manager"/>
            </xpath>
        </field>
    </record>

    <record id="res_users_form_views_inherit" model="ir.ui.view">
        <field name="name">res.users.form.views</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='login']" position="after">
                <group>
                    <field name="is_manager"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>