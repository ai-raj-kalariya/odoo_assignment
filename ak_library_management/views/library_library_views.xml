<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_library_list_view" model="ir.ui.view">
        <field name="name">library.library.list.view</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <list string="Libraries">
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <record id="library_library_form_view" model="ir.ui.view">
        <field name="name">library.library.form.view</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <form string="Library">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_borrowed_book"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="borrowed_book_count" widget="statinfo" string="Borrowed Book"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <!-- book tag view -->
                    <notebook>
                        <page string="Product">
                            <field name="product_ids" widget="one2many_list">
                                <list editable="bottom" create="0" edit="0">
                                    <field name="name"/>
                                    <field name="author_id"/>
                                    <field name="publisher"/>
                                    <field name="edition"/>
                                    <field name="published_date"/>
                                    <field name="available"/>
                                    <field name="pages"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--Activity -->
    <record id="library_library_actions" model="ir.actions.act_window">
        <field name="name">Libraries</field>
        <field name="res_model">library.library</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
