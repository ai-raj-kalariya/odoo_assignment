<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="external_layout_custom" inherit_id="web.external_layout_standard">
            <xpath expr="//div[@name='company_address']" position="replace">
                <div name="company_address" style="text-align: right;">
                    <span t-field="company.partner_id"
                          t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                    <div t-if="company.email">
                        Email:
                        <span t-field="company.email"/>
                    </div>
                    <div t-if="company.phone">
                        Phone:
                        <span t-field="company.phone"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('o_footer_content')]" position="replace">
                <div class="o_footer_content d-flex justify-content-between border-top pt-2">
                    <div class="text-start">
                        <span t-if="company.website" t-field="company.website"/>
                    </div>
                    <div class="text-end text-muted">
                        Page:
                        <span class="page"/>
                        /
                        <span class="topage"/>
                    </div>
                </div>
            </xpath>
        </template>

        <template id="library_qweb_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Library Qweb Report</h2>
                            <h3>
                                <span t-field="o.name"/>
                                #
                                <span t-field="o.id"/>
                            </h3>
                            <br/>
                            <br/>
                            <div class="row mb-4">
                                <div class="col">
                                    <strong>Librarian Name</strong>
                                    <div t-field="o.librarian_id.name">Mitchell Admin</div>
                                </div>
                                <div class="col">
                                    <strong>Date</strong>
                                    <div>10-March</div>
                                </div>
                                <div class="col">
                                    <strong>Total Borrowed Books Count</strong>
                                    <div t-out="float(o.borrowed_book_count)">0</div>
                                </div>
                                <div class="col">
                                    <strong>Location</strong>
                                    <div t-field="o.location">Ahm</div>
                                </div>
                            </div>
                            <table class="o_has_total_table table o_main_table table-borderless">
                                <thead>
                                    <tr>
                                        <th style="color: yellow;">
                                            <b>Book</b>
                                        </th>
                                        <th style="color: yellow;">Price</th>
                                        <th style="color: yellow;">Published Date</th>
                                        <th style="color: yellow;">Author</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.product_ids" t-as="p">
                                        <tr>
                                            <td>
                                                <b>
                                                    <span t-field="p.barcode"/>
                                                </b>
                                                <br/>
                                                <span t-field="p.name"/>
                                                <br/>
                                                <br/>
                                                <span>
                                                    <b>On Hand</b>
                                                </span>
                                                <br/>
                                                <span t-out="int(p.pages)"/>
                                            </td>
                                            <td>
                                                <span t-field="p.list_price"/>
                                            </td>
                                            <td>
                                                <span t-field="p.published_date" t-options="{'format':'d/MMM/yyyy'}"/>
                                            </td>
                                            <td>
                                                <span t-field="p.author_id.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div id="library_note">
                                <b>Note:</b>
                                <p t-field="o.notes"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>

    <record id="library_report_id" model="ir.actions.report">
        <field name="name">Library Report</field>
        <field name="model">library.library</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_library_management.library_qweb_report_template</field>
        <field name="report_file">ak_library_management.library_qweb_report_template</field>
    </record>
</odoo>