<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="basic_library_qweb_report_template">
        <div class="header o_standard_header">
            <div style="text-align:left;">Your logo</div>
            <div style="text-align:right;">
                <p>Aktiv Software<br/>"https://www.aktivsoftware.com"<br/>
                    10th Floor,Binori Bsquare 3,Sindhu Bhavan Road <br/>
                    India</p>
            </div>
        </div>

        <div class="page">
            <h2>Library Qweb Report</h2>
            <h3>
                <span t-field="o.name"/>
                #
                <span t-field="o.id"/>
            </h3>
            <br/>
            <br/>
            <table width="100%" style="text-align:center">
                <td width="25%">
                    <strong>Librarian Name</strong>
                    <div t-field="o.librarian_id.name">Mitchell Admin</div>
                </td>
                <td width="25%">
                    <strong>Date</strong>
                    <div>10-March</div>
                </td>
                <td width="25%">
                    <strong>Total Borrowed Books Count</strong>
                    <div t-out="float(o.borrowed_book_count)">0</div>
                </td>
                <td width="25%">
                    <strong>Location</strong>
                    <div t-field="o.location">Ahm</div>
                </td>
            </table>
            <table class="table-bordered" width="100%" style="border: 1px solid black; text-align:center;" >
                <thead>
                    <tr>
                        <th style="color: red;">
                            <b>Book</b>
                        </th>
                        <th style="color: red;">Price</th>
                        <th style="color: red;">Published Date</th>
                        <th style="color: red;">Author</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.product_ids" t-as="p">
                        <tr style="border: 1px solid black;">
                            <td>
                                <b><span t-field="p.barcode"/></b>
                                <br/>
                                <span t-field="p.name"/>
                                <br/><br/>
                                <span><b>On Hand</b></span>
                                <br/>
                                <span t-out="int(p.qty_available)"/>
                            </td>
                            <td>
                                <span t-field="p.list_price"/>
                            </td>
                            <td>
                                <span t-field="p.published_date" t-options="{'format':'d/MMM/yyyy'}"/>
                            </td>
                            <td>
                                <span t-field="p.author_id.name"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <p t-field="o.notes"/>
        </div>
        <div class="footer o_standard_footer">
            <div class="row text-center" style="border-top: 1px solid black">
                <span>www.aktivsoftware.com</span>
            </div>
        </div>
    </template>

    <template id="custom_library_qweb_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ak_library_management.basic_library_qweb_report_template"/>
            </t>
        </t>
    </template>

    <record id="custom_library_report_id" model="ir.actions.report">
        <field name="name">Custom Library Report</field>
        <field name="model">library.library</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_library_management.custom_library_qweb_report_template</field>
        <field name="report_file">ak_library_management.custom_library_qweb_report_template</field>
    </record>
</odoo>
